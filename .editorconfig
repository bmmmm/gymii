# What every file in this repo already is (checked 2026-10-23) — written
# down so an editor keeps it that way. Lint is Biome's job; this is bytes.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
