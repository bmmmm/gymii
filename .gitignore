.DS_Store
.claude/

# The test tooling (Playwright, Biome) is the repo's only dependency, and
# none of what it leaves behind ships: the deploy uploads app/, and an
# install lands in the root. node_modules/ first all the same: it must be
# ignored BEFORE any install runs, or a working tree fills with untracked
# files.
node_modules/
# npm writes its lockfile before the preinstall guard can refuse it
package-lock.json
yarn.lock
# Playwright's run output
test-results/
playwright-report/
blob-report/
